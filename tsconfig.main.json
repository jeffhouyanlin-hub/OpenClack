{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "dist/main",
    "noEmit": false,
    "types": ["node"]
  },
  "include": ["src/main/**/*", "src/types/**/*"],
  "exclude": ["node_modules", "dist"]
}
